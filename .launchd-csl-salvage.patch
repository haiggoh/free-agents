+# ---------------------------------------------------------------------------
+# Launchd management menu — allows users to manage automatic update checks
+# ---------------------------------------------------------------------------
+_run_launchd_menu() {
+  NEXT_LANE="home"
+  while :; do
+    echo
+    _box top
+    _box center "🔧 Launchd Management (Automatic Update Checks)"
+    _box mid
+    _box row "This manages the weekly launchd job that checks for backend updates."
+    _box mid
+    _box row "  1) 📥 Install launchd plist (weekly checks at Mon 10:17 AM)"
+    _box row "  2) 📤 Uninstall launchd plist"
+    _box row "  3) 📊 Show launchd status"
+    _box row "  4) ▶️  Run update check once now"
+    _box row "  h) 🏠 Back to main menu"
+    _box row "  q) Quit"
+    _box mid
+    printf "Select [1-4/h/q]: " >&2
+    read -r sel; sel="${sel:-h}"
+    case "$sel" in
+      1) python3 "$CSL_DIR/../install/manage-backend.py" --backend rapid-mlx launchd install; continue ;;
+      2) python3 "$CSL_DIR/../install/manage-backend.py" --backend rapid-mlx launchd uninstall; continue ;;
+      3) python3 "$CSL_DIR/../install/manage-backend.py" --backend rapid-mlx launchd status; continue ;;
+      4) python3 "$CSL_DIR/../install/manage-backend.py" --backend rapid-mlx launchd run-once; continue ;;
+      h|H) NEXT_LANE="home"; return ;;
+      q|Q) NEXT_LANE="quit"; return ;;
+      *) echo "Invalid selection." >&2; continue ;;
+    esac
+  done
+}
+
 # ---------------------------------------------------------------------------
 # Main loop — owns the interactive state. Each lane runs as a function in this
 # shell so state (AUTO_MODE_STATE, TELEMETRY, WATCH, STOP_HOOK, LOCAL_CAPABLE)
@@ -762,6 +800,7 @@ while [ "$NEXT_LANE" != "quit" ]; do
   case "$NEXT_LANE" in
     home)   _pick_home_lane ;;
     local)  _run_local_picker ;;
+    launchd_menu) _run_launchd_menu ;;
     remote)
       # Delegate to remote-session.sh which now has its own interactive loop.
       # It returns (does not exec) when the user navigates back or quits.
