#!/usr/bin/env python3
"""fa-takeover — deterministic budget-wall takeover CLI (plan v2 Task 1.3).

Subcommands: capture SESSION_ID|TRANSCRIPT --route ALIAS [--cwd DIR] [--allow-findings]
[--dry-run] [--json] [--scan] · launch TAKEOVER_ID [--effort LEVEL] · verify TAKEOVER_ID
[--timeout SECS] · list · show TAKEOVER_ID

Exit codes: 0 ok · 2 usage · 3 refused (CaptureRefused) · 4 not found · 5 not
delivered/not read · 6 needs a TTY.

Environment: FA_TAKEOVER_DIR (takeover state root, override of the XDG default —
an invalid value aborts loudly), FA_TAKEOVER_LAUNCHER (launch-remote-window.sh override),
FA_TAKEOVER_ROUTE (default route for the hook), XDG_STATE_HOME. No model or route name
is hardcoded: routes resolve from the roster config/remote-agents.sh at run time.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fa_capture
import fa_transcript
# Route resolution and the external secret scanner live in fa_capture (the hook imports
# them from there too); re-exported here so existing callers/tests keep working.
from fa_capture import Route, external_secret_scanner, resolve_takeover_route  # noqa: F401

DEFAULT_LAUNCHER = Path(__file__).resolve().parent / "launch-remote-window.sh"

EXIT_OK, EXIT_USAGE, EXIT_REFUSED, EXIT_NOT_FOUND, EXIT_NOT_DELIVERED, EXIT_NO_TTY = 0, 2, 3, 4, 5, 6

LAUNCH_PROMPT = ("Read {handoff} first and follow it exactly: adopt its standing rules, "
                 "produce the reconciliation, then wait.")


def _root() -> Path:
    return fa_capture.default_root()  # raises ValueError naming FA_TAKEOVER_DIR when invalid


def _home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def _find_transcript(arg: str):
    """A path, or a SESSION_ID resolved by EXACT filename ~/.claude/projects/*/<id>.jsonl
    (never the newest). Returns None when no exact match; raises ValueError when ambiguous."""
    p = Path(arg)
    if p.is_file():
        return str(p.resolve())
    matches = sorted(_home().glob(f".claude/projects/*/{arg}.jsonl"))
    if not matches:
        return None
    if len(matches) > 1:
        raise ValueError(f"session id {arg!r} matches multiple transcripts: "
                         + ", ".join(str(m) for m in matches))
    return str(matches[0])


def cmd_capture(args) -> int:
    root = _root()
    try:
        transcript = _find_transcript(args.session)
    except ValueError as e:
        print(f"fa-takeover: {e}", file=sys.stderr)
        return EXIT_USAGE
    if transcript is None:
        print(f"fa-takeover: no transcript for {args.session!r} under "
              f"{_home()}/.claude/projects/*/", file=sys.stderr)
        return EXIT_NOT_FOUND
    try:
        route = resolve_takeover_route(args.route)
    except ValueError as e:
        print(f"fa-takeover: {e}", file=sys.stderr)
        return EXIT_USAGE
    scanner = external_secret_scanner() if args.scan else None
    reason = f"manual capture of session {args.session} (fa-takeover capture)"
    try:
        pkg = fa_capture.build_package(
            transcript, cwd=args.cwd or os.getcwd(), dest_route=route.alias,
            dest_window_tokens=route.window_tokens,
            base_overhead_tokens=args.base_overhead_tokens or fa_capture.DEFAULT_BASE_OVERHEAD_TOKENS,
            reason=reason, scanner=scanner, allow_findings=args.allow_findings)
    except fa_capture.CaptureRefused as e:
        print(f"fa-takeover: capture refused ({e.code}): {e.message}", file=sys.stderr)
        return EXIT_REFUSED
    if args.dry_run:
        print("fa-takeover: dry-run — nothing written, nothing spawned. Planned manifest:")
        print(json.dumps({"takeover_id": pkg.takeover_id, "counts": pkg.manifest["counts"],
                          "dest": pkg.manifest["dest"]}, indent=2))
        return EXIT_OK
    out = fa_capture.write_package(pkg, root)
    if args.json:
        print(json.dumps(pkg.manifest, indent=2, sort_keys=True))
    else:
        print(f"fa-takeover: package ready at {out}")
        print(f"  route: {route.alias} (window {route.window_tokens}, budget "
              f"{pkg.manifest['dest']['budget_tokens']} tokens)")
        print(f"  next:  fa-takeover launch {pkg.takeover_id}")
    return EXIT_OK


def cmd_launch(args) -> int:
    root = _root()
    pkg_dir = root / args.takeover_id
    if not pkg_dir.is_dir():
        print(f"fa-takeover: no takeover package {args.takeover_id!r} under {root}",
              file=sys.stderr)
        return EXIT_NOT_FOUND
    manifest = json.loads((pkg_dir / "manifest.json").read_text(encoding="utf-8"))
    handoff = pkg_dir / "handoff.md"
    route = manifest["dest"]["route"]
    effort = args.effort or "max"
    launcher = os.environ.get("FA_TAKEOVER_LAUNCHER") or str(DEFAULT_LAUNCHER)
    cmd = [launcher, route, "--effort", effort,
           "--prompt", LAUNCH_PROMPT.format(handoff=handoff),
           "--", "--permission-mode", "plan"]
    if not sys.stdin.isatty():
        print("fa-takeover: launch needs a TTY — run this in Terminal.app, not from an agent:")
        print("  " + " ".join(shlex.quote(c) for c in cmd))
        return EXIT_NO_TTY
    return subprocess.run(cmd).returncode


def _successor_transcript(handoff_path: str, source_path: str):
    """The NEWEST transcript whose first genuine instruction names the handoff path
    (final review finding 5: an abandoned earlier launch must not win over the newest).
    The source session is excluded by realpath."""
    handoff_path = str(handoff_path)
    source_real = os.path.realpath(source_path) if source_path else None
    best = None
    best_mtime = -1.0
    for t in _home().glob(".claude/projects/*/*.jsonl"):
        if os.path.realpath(str(t)) == source_real:
            continue
        try:
            records, _malformed = fa_transcript.load_records(str(t))
        except Exception:
            continue
        instrs = fa_transcript.user_instructions(records)
        if instrs and handoff_path in instrs[0].text:
            mt = t.stat().st_mtime
            if mt > best_mtime:
                best, best_mtime = str(t), mt
    return best


def cmd_verify(args) -> int:
    root = _root()
    pkg_dir = root / args.takeover_id
    if not pkg_dir.is_dir():
        print(f"fa-takeover: no takeover package {args.takeover_id!r} under {root}",
              file=sys.stderr)
        return EXIT_NOT_FOUND
    manifest = json.loads((pkg_dir / "manifest.json").read_text(encoding="utf-8"))
    handoff = pkg_dir / "handoff.md"
    nonce = None
    for line in handoff.read_text(encoding="utf-8").splitlines():
        if line.startswith("TAKEOVER-NONCE: "):
            nonce = line.split(": ", 1)[1]
    if nonce is None:
        print("fa-takeover: package handoff.md has no TAKEOVER-NONCE line", file=sys.stderr)
        return EXIT_NOT_FOUND
    nonce_line = f"TAKEOVER-NONCE: {nonce}"
    source_path = manifest["source"]["transcript_path"]

    deadline = time.monotonic() + args.timeout
    succ = None
    while True:
        succ = _successor_transcript(handoff, source_path)
        if succ or time.monotonic() >= deadline:
            break
        time.sleep(2)
    if not succ:
        print("DELIVERED: no")
        return EXIT_NOT_DELIVERED
    print(f"DELIVERED: yes ({succ})")

    records, _malformed = fa_transcript.load_records(succ)
    read_line = None
    for ln, _tool_use_id, content in fa_transcript.tool_result_texts(records):
        if nonce_line in content:
            read_line = ln  # the nonce entered the model's context via a tool_result
    if read_line is None:
        print("READ: no")
        return EXIT_NOT_DELIVERED
    print(f"READ: yes (tool_result at line {read_line})")

    reconciled = False
    for ln, rec in records:
        if read_line is not None and ln <= read_line:
            continue
        if rec.get("type") == "assistant":
            text = fa_transcript.message_text(rec)
            if "## Takeover reconciliation" in text and nonce in text:
                reconciled = True
    print(f"RECONCILED (self-reported): {'yes' if reconciled else 'no'}")

    pmodes = sorted({rec.get("permissionMode") for _ln, rec in records
                     if rec.get("type") == "user" and rec.get("permissionMode")})
    if pmodes:
        print("permissionMode: " + ", ".join(pmodes))
    return EXIT_OK  # DELIVERED + READ is the contract; RECONCILED is reported, not required


def cmd_list(args) -> int:
    root = _root()
    if not root.is_dir():
        print("fa-takeover: no takeover packages (root does not exist yet)")
        return EXIT_OK
    rows = []
    for d in sorted(root.glob("tk-*")):
        if not d.is_dir():
            continue
        try:
            m = json.loads((d / "manifest.json").read_text(encoding="utf-8"))
            rows.append(f"{m['takeover_id']}\t{m.get('created_at', '?')}\t"
                        f"{m['dest']['route']}\t{m.get('reason', '')[:80]}")
        except Exception:
            rows.append(f"{d.name}\t(unreadable manifest)")

    print("\n".join(rows) if rows else "fa-takeover: no takeover packages")
    return EXIT_OK


def cmd_show(args) -> int:
    root = _root()
    pkg_dir = root / args.takeover_id
    if not pkg_dir.is_dir():
        print(f"fa-takeover: no takeover package {args.takeover_id!r} under {root}",
              file=sys.stderr)
        return EXIT_NOT_FOUND
    print((pkg_dir / "manifest.json").read_text(encoding="utf-8"))
    print(f"handoff: {pkg_dir / 'handoff.md'}")
    return EXIT_OK


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="fa-takeover",
        description="Deterministic budget-wall takeover: capture a transcript into a "
                    "package, launch a free successor in a real window, verify delivery "
                    "and reading. Exit codes: 0 ok, 2 usage, 3 refused, 4 not found, "
                    "5 not delivered/not read, 6 needs a TTY.",
        epilog="Env: FA_TAKEOVER_DIR (state root override; invalid aborts loudly), "
               "FA_TAKEOVER_LAUNCHER, FA_TAKEOVER_ROUTE, XDG_STATE_HOME.")
    sub = p.add_subparsers(dest="command", required=True)

    c = sub.add_parser("capture", help="build a takeover package from SESSION_ID or a transcript path")
    c.add_argument("session", help="session id (exact transcript filename) or a transcript file path")
    c.add_argument("--route", default=None,
                   help="destination route alias (roster); default: first session-capable route")
    c.add_argument("--cwd", default=None, help="working directory for git state (default: cwd)")
    c.add_argument("--allow-findings", action="store_true",
                   help="record secret-scan findings in the manifest instead of refusing")
    c.add_argument("--dry-run", action="store_true", help="write nothing, spawn nothing; print planned counts")
    c.add_argument("--json", action="store_true", help="print the manifest JSON on success")
    c.add_argument("--scan", action="store_true",
                   help="scan with the installed audit-loose-ends redact-secret.py (resolved at run time)")
    c.add_argument("--base-overhead-tokens", type=int, default=0,
                   help="override the engine base-overhead reserve (default: measured constant)")
    c.set_defaults(func=cmd_capture)

    lp = sub.add_parser("launch", help="launch the free successor in a REAL window (needs a TTY)")
    lp.add_argument("takeover_id")
    lp.add_argument("--effort", default=None, help="effort level for the successor (default: max)")
    lp.set_defaults(func=cmd_launch)

    v = sub.add_parser("verify", help="prove DELIVERED / READ / RECONCILED for a package")
    v.add_argument("takeover_id")
    v.add_argument("--timeout", type=int, default=900, help="seconds to wait for the successor (default 900)")
    v.set_defaults(func=cmd_verify)

    ls = sub.add_parser("list", help="list takeover packages")
    ls.set_defaults(func=cmd_list)

    s = sub.add_parser("show", help="show one package's manifest")
    s.add_argument("takeover_id")
    s.set_defaults(func=cmd_show)
    return p


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except ValueError as e:
        # an explicit override (FA_TAKEOVER_DIR) that is set but invalid fails loudly
        print(f"fa-takeover: {e}", file=sys.stderr)
        return EXIT_USAGE


if __name__ == "__main__":
    raise SystemExit(main())
