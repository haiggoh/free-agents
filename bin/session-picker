#!/usr/bin/env bash
# session-picker — start the Free Agents session picker UI (Textual) from any entry point.
#
# Usage: session-picker [home|local|remote|lowkey|download|rate-limiter|remote_filters] [--exclude-trials]
#                       [--local-capable-shown] [--help]
#
# Environment:
#   LA_PICKER_VENV   picker venv (default ~/.local/share/free-agents/picker-venv)
#
# If the venv is missing this prints the one command that creates it and exits 3. It never
# falls back to an old numbered menu.
set -uo pipefail
# The FIRST thing on screen is the loading frame, never a bare clear (cbd6302 cleared to a blank
# screen ~0.25 s after the shell had already echoed the launch command and "Last login", which
# stayed visible until the clear landed). Only for an interactive terminal and not for --help, so
# pipes, logs and tests see no escape bytes. The alternate screen hides whatever the shell
# printed before us; Textual takes it over without a flash. The ⏳ comes from config/emoji.sh.
case "${1:-}" in -h|--help) ;; *)
  if [ -t 1 ]; then
    _hg="$(sed -n 's/^EMOJI_LOADING="\([^"]*\)".*/\1/p' "$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)/../config/emoji.sh" 2>/dev/null)"
    printf '\033[?1049h\033[2J\033[H\033[?25l  %s loading.  ' "${_hg:-…}"
    # Any exit BEFORE the exec below (venv missing, signal) must give the screen back, or the
    # user is left on a blank alternate screen with no cursor. The exec replaces this shell, so
    # the trap never fires once Textual owns the terminal (Textual restores it itself).
    trap 'printf "\033[?25h\033[?1049l"' EXIT
  fi ;;
esac
_s="${BASH_SOURCE[0]}"; while [ -h "$_s" ]; do _d="$(cd -P "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"; case "$_s" in /*) ;; *) _s="$_d/$_s";; esac; done
BIN="$(cd -P "$(dirname "$_s")" && pwd)"
VENV="${LA_PICKER_VENV:-$HOME/.local/share/free-agents/picker-venv}"
PY="$VENV/bin/python"

case "${1:-}" in
  -h|--help) sed -n '2,/^set -uo/{/^set -uo/d;s/^# \{0,1\}//;p;}' "$0"; exit 0 ;;
esac
if [ ! -x "$PY" ] || ! "$PY" -c 'import textual' 2>/dev/null; then
  echo "session-picker: the picker UI is not installed yet. Run once:" >&2
  echo "  $(cd "$BIN/.." && pwd)/install/setup-session-picker.sh" >&2
  exit 3
fi
exec "$PY" "$BIN/session_picker.py" "$@"
