#!/usr/bin/env bash
# csl — "claude session local": front-end for launch-claude-agent.sh.
#
#   csl              -> interactive picker (all available models, effort override, watcher toggle)
#   csl roles        -> disk-aware role resolver (which on-disk model fills each role)
#   csl remote [args...] -> remote picker, alias, --list, --verify, or --include-trials
#   csl <args...>    -> passed straight through to the launcher, unchanged (no picker, no watcher)
#
# WHY the picker offers free model×effort and not just presets: dispatching local models as
# SUBAGENTS and running a local model as the SESSION ENGINE are different decisions. For dispatch,
# fixed role archetypes are the point — you route a task to the model whose strengths suit it, and
# that matters most when several agents run at once. For a session there is exactly ONE engine, and
# the model×effort pairing is the main lever you have over speed vs quality for everything you do
# in that session. The primary menu therefore shows every available session model at its configured
# default effort; custom effort composition remains available explicitly.
#
# Duplicates NO config: models, roles and presets all come from the config overlay.
set -uo pipefail
# Resolve symlinks so `csl` on PATH (a symlink into this repo) finds the config (portable).
_s="${BASH_SOURCE[0]}"; while [ -h "$_s" ]; do _d="$(cd -P "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"; case "$_s" in /*) ;; *) _s="$_d/$_s";; esac; done
CSL_DIR="$(cd -P "$(dirname "$_s")" && pwd)"
LAUNCHER="${CSL_LAUNCHER:-$CSL_DIR/launch-claude-agent.sh}"
WATCHER="$CSL_DIR/local-watch.sh"

if [ "${1:-}" = "roles" ]; then shift; exec "$CSL_DIR/la-roles.sh" "$@"; fi
if [ "${1:-}" = "setup-remote" ]; then
  shift
  exec python3 "$CSL_DIR/../install/setup-api-keys.py" "$@"
fi
if [ "${1:-}" = "remote" ]; then
  shift
  exec "${CSL_REMOTE_LAUNCHER:-$CSL_DIR/remote-session.sh}" "$@"
fi
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  printf '%s\n' 'csl: choose a local or remote Claude Code session.' \
    'Usage: csl | csl roles [args] | csl remote [alias/options] | csl <local-launcher args>' \
    'Remote help: csl remote --help; include Cerebras: csl remote --include-trials' \
    'Key setup: csl setup-remote [providers] | csl setup-remote --list (no API calls)' \
    'Environment: CSL_LAUNCHER, CSL_REMOTE_LAUNCHER override launchers; CSL_WATCH,' \
    'CSL_AUTO_MODE_STATE (0=blind-trust,1=classifier,2=off), CSL_TELEMETRY control local picker defaults.' \
    'For local launcher details: launch-claude-agent.sh --help'
  exit 0
fi
# shellcheck source=/dev/null
. "$CSL_DIR/../config/config-lib.sh"
la_load_config || exit 1

EFFORTS=(low medium high xhigh max)     # claude --effort <level>
# Watcher defaults OFF: ordinary selection should open only the requested local session.
# Toggle it with `w`, or set CSL_WATCH=1 to opt in by default.
WATCH="${CSL_WATCH:-0}"

# Apply a model-specific auto-compaction override only inside this csl process.
# The export is inherited by the selected local launcher but cannot propagate
# back into the parent shell or into an independently launched cloud session.
_apply_session_profile() {
  local alias="$1"
  local auto_compact="${LA_SESSION_AUTO_COMPACT[$alias]:-}"

  if [ -n "$auto_compact" ]; then
    export LA_AUTO_COMPACT_WINDOW="$auto_compact"
  fi
}

# Auto-mode triple-toggle state. Three mutually exclusive states cycle with `a`:
#
#   0 = blind-trust   → --permission-mode auto, NO classifier in the loop. Every consequential
#                       call is routed directly to auto. This is the DEFAULT because the genuine
#                       classifier emulation path is not yet working reliably; blind-trust gives
#                       auto-mode behaviour immediately without waiting for a classifier server.
#   1 = classifier    → --permission-mode auto, boots a second local model to judge auto-mode
#                       calls. The real auto mode — requires the classifier warm-up path.
#   2 = off           → --permission-mode acceptEdits. No auto-mode behaviour at all.
#
# Defaults to 0 (blind-trust). Cycle: blind-trust → classifier → off → blind-trust.
# The launcher maps these to LA_AUTO_MODE and LA_BLIND_AUTO:
#   state=0 → LA_AUTO_MODE=1 LA_BLIND_AUTO=1
#   state=1 → LA_AUTO_MODE=1 LA_BLIND_AUTO=0
#   state=2 → LA_AUTO_MODE=0 (LA_BLIND_AUTO is irrelevant)
# Environment overrides: CSL_AUTO_MODE_STATE=<0|1|2> sets the initial state directly.
AUTO_MODE_STATE="${CSL_AUTO_MODE_STATE:-0}"

# Telemetry state. OFF by default: the point of a local session is that the work stays on this
# machine, and a session that still reports to Statsig/Sentry and polls for updates is not that.
# Measured 2026-09-05 on a session whose inference was provably 100% local — it still held two
# outbound HTTPS sockets, to Anthropic (160.79.104.10) and to Google/Statsig (34.149.66.165). Those
# are not inference and they are not the gateway, so they are easy to mistake for noise and easy to
# miss entirely; they are also outbound calls the user never asked for.
#
# TELEMETRY=0 (the default) means "no nonessential traffic". Toggle with `t`, or set CSL_TELEMETRY=1
# to leave the stock behaviour in place. The launcher turns this into the actual env vars, so the
# same switch works for any caller of launch-claude-agent.sh, not just this picker.
TELEMETRY="${CSL_TELEMETRY:-0}"

# Argument passthrough still skips the picker and watcher. It now receives the
# same selected-model profile as an interactive numbered choice.
if [ "$#" -gt 0 ]; then
  _apply_session_profile "$1"
  exec "$LAUNCHER" "$@"
fi

# Session-capable models only — dispatch-only tiers have no Anthropic /v1/messages surface, so
# they cannot drive an interactive session at all. mlx_lm.server serves OpenAI-only under a path
# id; llama.cpp's llama-server likewise. rapid and vllm both expose /v1/messages.
# LA_SERVE holds the RESOLVED backend (la_finalize_serve ran inside la_load_config), so the
# generic "mlx" / "" declarations never reach this test — they arrive here as rapid or vllm.
SESSION_ALIASES=()
for a in "${LA_ALIASES[@]}"; do
  case "${LA_SERVE[$a]:-}" in
    rapid|vllm)
      la_on_disk "$a" && SESSION_ALIASES+=("$a")
      ;;
    *) ;;
  esac
done

if [ "${#SESSION_ALIASES[@]}" -eq 0 ]; then
  echo "No on-disk models with an Anthropic-compatible session backend are available." >&2
  exit 1
fi

MODEL_LABELS=()
for a in "${SESSION_ALIASES[@]}"; do
  roles="$(la_roles_for_alias "$a")"
  [ -n "$roles" ] || roles="untagged"
  MODEL_LABELS+=("$(
    printf '%-30s backend=%-20s thinking=%-5s effort=%-6s roles=%s' \
      "$a" \
      "$(la_serve_display "$a")" \
      "${LA_THINK[$a]:-?}" \
      "${LA_EFFORT[$a]:-?}" \
      "$roles"
  )")
done

_pick_from() {   # $1=prompt  $2=default index (1-based)  rest=items -> echoes chosen 1-based index
  # The list and the prompt go to STDERR on purpose: this function is called inside $(...), which
  # captures stdout, so anything printed there would be swallowed into the caller's variable
  # instead of shown to the user (and would then fail the numeric check).
  local prompt="$1" def="$2"; shift 2
  local n=$#
  local i=1
  for it in "$@"; do printf "  %d) %s\n" "$i" "$it" >&2; i=$((i+1)); done
  local c; printf "%s [%s]: " "$prompt" "$def" >&2; read -r c; c="${c:-$def}"
  if ! [[ "$c" =~ ^[0-9]+$ ]] || [ "$c" -lt 1 ] || [ "$c" -gt "$n" ]; then echo "0"; return; fi
  echo "$c"
}

# ☁️  REMOTE cloud-API agents are a DELIBERATELY SEPARATE list from the local models
# above: a remote agent runs on a third party's hardware over the network, with a
# different cost model (free-tier quota, not free compute) and a different privacy
# posture (prompts leave this machine). Mixing them into one menu would make those
# two very different choices look interchangeable, so `r` opens its own roster.
_remote_launcher() { echo "${CSL_REMOTE_LAUNCHER:-$CSL_DIR/remote-session.sh}"; }

_launch_remote() {  # opens the remote roster and hands off; never returns on success
  local rl; rl="$(_remote_launcher)"
  if [ ! -x "$rl" ]; then
    echo "csl: remote session launcher not found or not executable: $rl" >&2
    return 1
  fi
  exec "$rl"
}

# Map the triple-toggle state to the env vars launch-claude-agent.sh expects.
# State 0 (blind-trust)  → LA_AUTO_MODE=1 LA_BLIND_AUTO=1
# State 1 (classifier)   → LA_AUTO_MODE=1 LA_BLIND_AUTO=0
# State 2 (off)          → LA_AUTO_MODE=0
_la_auto_mode_val() { [ "$AUTO_MODE_STATE" = "2" ] && echo 0 || echo 1; }
_la_blind_auto_val() { [ "$AUTO_MODE_STATE" = "0" ] && echo 1 || echo 0; }

_launch() {  # $1=alias  $2=effort(optional)
  local alias="$1" effort="${2:-}"
  _apply_session_profile "$alias"
  if [ "$WATCH" = "1" ]; then
    if [ "$(uname -s)" = "Darwin" ]; then
      # $$ is THIS shell's pid, and `exec` below replaces it with the launcher — so the pid the
      # watcher is told to follow is exactly the launcher pid it will see in pgrep. --attach waits
      # for that session's port/transcript sidecars, so spawning it first is safe.
      osascript >/dev/null 2>&1 <<OSA
tell application "Terminal"
  do script "'$WATCHER' --attach $$"
end tell
OSA
      echo "👁  watcher window opened (following pid $$; engine health now, mutations from turn 1)"
    else
      echo "👁  watcher (run in another terminal): $WATCHER --attach $$"
    fi
  fi
  local _am _ba
  _am="$(_la_auto_mode_val)"
  _ba="$(_la_blind_auto_val)"
  if [ -n "$effort" ]; then
    exec env LA_AUTO_MODE="$_am" LA_BLIND_AUTO="$_ba" LA_TELEMETRY="$TELEMETRY" "$LAUNCHER" "$alias" "$effort"
  else
    exec env LA_AUTO_MODE="$_am" LA_BLIND_AUTO="$_ba" LA_TELEMETRY="$TELEMETRY" "$LAUNCHER" "$alias"
  fi
}

while :; do
  echo
  echo "Local agents — launch a local session (config: ${LA_CONFIG_SOURCE})"
  echo
  echo "Available models (on disk, session-capable; numbered rows use the configured effort):"
  for ((i=0; i<${#MODEL_LABELS[@]}; i++)); do
    printf "  %d) %s\n" "$((i+1))" "${MODEL_LABELS[$i]}"
  done
  echo
  echo "  c) choose a listed model × custom effort"
  echo "  r) ☁️  remote API agents (choose provider/model; account quotas apply)"
  echo "     Cerebras trial opt-in: csl remote --include-trials"
  echo "  i) install / set up remote API keys"
  if [ "$WATCH" = "1" ]; then echo "  w) watcher: ON  — opens a window following this session (toggle)"
  else                        echo "  w) watcher: OFF — no monitor window (toggle)"; fi
  case "$AUTO_MODE_STATE" in
    0) echo "  a) auto-mode: blind-trust — auto with no classifier (cycle: blind→classifier→off)" ;;
    1) echo "  a) auto-mode: classifier  — auto with local classifier (cycle: blind→classifier→off)" ;;
    2) echo "  a) auto-mode: off         — acceptEdits; no classifier (cycle: blind→classifier→off)" ;;
  esac
  if [ "$TELEMETRY" = "1" ]; then echo "  t) telemetry: ON  — stock Claude Code reporting/update checks (toggle)"
  else                            echo "  t) telemetry: OFF — no nonessential outbound traffic (toggle)"; fi
  echo "  q) quit"
  echo
  printf "Selection [1]: "; read -r sel; sel="${sel:-1}"
  case "$sel" in
    q|Q) exit 0 ;;
    i|I) python3 "$CSL_DIR/../install/setup-api-keys.py"; continue ;;
    r|R) _launch_remote || continue ;;
    w|W) if [ "$WATCH" = "1" ]; then WATCH=0; else WATCH=1; fi; continue ;;
    a|A) AUTO_MODE_STATE=$(( (AUTO_MODE_STATE + 1) % 3 )); continue ;;
    b|B) AUTO_MODE_STATE=0; continue ;;  # b shortcut: jump straight to blind-trust
    t|T) if [ "$TELEMETRY" = "1" ]; then TELEMETRY=0; else TELEMETRY=1; fi; continue ;;
    c|C)
      echo >&2
      echo "Models (on disk, session-capable):" >&2
      mi=$(_pick_from "Model" 1 "${MODEL_LABELS[@]}")
      [ "$mi" = "0" ] && { echo "Invalid selection."; continue; }
      chosen="${SESSION_ALIASES[$((mi-1))]}"
      echo >&2
      echo "Effort — higher reasons more and takes longer; lower answers sooner:" >&2
      ei=$(_pick_from "Effort" 3 "${EFFORTS[@]}")
      [ "$ei" = "0" ] && { echo "Invalid selection."; continue; }
      _launch "$chosen" "${EFFORTS[$((ei-1))]}"
      ;;
    *)
      if ! [[ "$sel" =~ ^[0-9]+$ ]] || [ "$sel" -lt 1 ] || [ "$sel" -gt "${#SESSION_ALIASES[@]}" ]; then
        echo "Invalid selection."; continue
      fi
      chosen="${SESSION_ALIASES[$((sel-1))]}"
      _launch "$chosen" "${LA_EFFORT[$chosen]:-}"
      ;;
  esac
done
