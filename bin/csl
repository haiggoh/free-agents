#!/usr/bin/env bash
# csl — "Claude Code Free-Agents: Session Launcher"
#
#   csl              -> session picker Home (Local / Remote / tools), arrow keys + letters
#   csl local        -> Local Session Picker directly (Quit, no Back)
#   csl remote [args...] -> Remote picker directly, or an alias / --list / --verify / ...
#   csl lowkey [args...] / csl download-models [args...] -> those tools (picker when no args)
#   csl roles        -> disk-aware role resolver (which on-disk model fills each role)
#   csl <args...>    -> passed straight through to the local launcher, unchanged (no picker, no watcher)
#
# WHY the picker offers free model×effort and not just presets: dispatching local models as
# SUBAGENTS and running a local model as the SESSION ENGINE are different decisions. For dispatch,
# fixed role archetypes are the point — you route a task to the model whose strengths suit it, and
# that matters most when several agents run at once. For a session there is exactly ONE engine, and
# the model×effort pairing is the main lever you have over speed vs quality for everything you do
# in that session. The primary menu therefore shows every available session model at its configured
# default effort; custom effort composition remains available explicitly.
#
# Duplicates NO config: models, roles and presets all come from the config overlay.
set -uo pipefail
# Resolve symlinks so `csl` on PATH (a symlink into this repo) finds the config (portable).
_s="${BASH_SOURCE[0]}"; while [ -h "$_s" ]; do _d="$(cd -P "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"; case "$_s" in /*) ;; *) _s="$_d/$_s";; esac; done
CSL_DIR="$(cd -P "$(dirname "$_s")" && pwd)"
LAUNCHER="${CSL_LAUNCHER:-$CSL_DIR/launch-claude-agent.sh}"
WATCHER="$CSL_DIR/local-watch.sh"

# Source emoji constants for dry-run output (single source of truth)
# shellcheck source=../config/emoji.sh
. "$CSL_DIR/../config/emoji.sh"

# Argument parsing BEFORE any work (must support --help/--dry-run without side effects)
# Parse all leading flags first, then handle subcommands/passthrough
while [[ $# -gt 0 ]]; do
  case "${1:-}" in
    -h|--help)
      cat <<'HELP'
csl — Claude Code Free-Agents: Session Launcher

Usage: csl [--help] [--dry-run] | csl local | csl remote [args] | csl lowkey [args]
       csl download-models [args] | csl roles [args] | csl <alias> [effort]

Modes:
  csl                    Session picker Home (q quits)
  csl local              Local Session Picker directly (q quits, no Back)
  csl remote [args]      Remote Free API Session Picker, or remote-session.sh with args
  csl lowkey [args]      Lowkey picker, or lowkey-cli.py with args
  csl download-models [args]  Model downloader picker, or the engine with args
  csl roles [args]       Disk-aware role resolver (la-roles.sh)
  csl <alias> [effort]   Direct passthrough to local launcher (no picker)

Picker keys: arrows move, Enter opens a group / launches, l Local, r Remote, s switch lane,
e effort, a auto-mode, t telemetry, p queued-prompt hook, w watcher, m MCPs, k API keys,
v Rapid-MLX runtime, n NVIDIA rate limiter, h Theme colors (Home), trial rows (Remote), b Back, q Quit.
Effort chosen in a picker is remembered in config/session-menu.local.json.

Flags:
  --help       Show this help and exit
  --dry-run                  Validate config and show what would be available, without launching
  --dry-run-skip-preflight   Dry-run without RAM preflight (quick config inspection)
  --inventory  Print session-capable local models as TSV for the picker, then exit
  --enable-mcp               Enable MCPs in blind-trust mode

Subcommands:
  roles              Show which on-disk model fills each role (operator, reasoner, etc.)
  setup-remote       Install / set up remote API keys (csl setup-remote [providers])
  remote             Delegate to remote-session.sh (see 'csl remote --help')

Environment:
  CSL_LAUNCHER           Override local launcher (default: launch-claude-agent.sh)
  CSL_REMOTE_LAUNCHER    Override remote launcher (default: remote-session.sh)
  CSL_WATCH=1            Default watcher ON
  CSL_AUTO_MODE_STATE=0|1|2  Initial auto-mode: 0=blind-trust, 1=classifier, 2=off
  CSL_TELEMETRY=1        Default telemetry ON (default OFF)
  CSL_STOP_HOOK=1        Default stop hook ON (default OFF since 0.22.3)
  CSL_LOCAL_CAPABLE=1    Show local-capable models in remote picker (default hidden)

Examples:
  csl                                    # Interactive picker
  csl --dry-run                          # Show available models/toggles without launching
  csl roles                              # Show role bindings
  csl remote --list                      # List remote agents
  csl qwen-3.8-operator high             # Direct launch (no picker)
  csl --enable-mcp                       # Enable MCPs in blind-trust mode
HELP
      exit 0
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --dry-run-skip-preflight)
      export LA_DRY_RUN_SKIP_PREFLIGHT=1
      DRY_RUN=1
      shift
      ;;
    --enable-mcp)
      export LA_ENABLE_MCP=1
      shift
      ;;
    --inventory)
      INVENTORY=1
      shift
      ;;
    --picker-launch)
      break   # internal: picker -> local session; handled after config load
      ;;
    --register-model|--unregister-model)
      break   # internal: picker registry hygiene; handled after config load
      ;;
    -?*)
      printf 'csl: unrecognised option: %s\n' "$1" >&2
      printf "Try 'csl --help'.\n" >&2
      exit 2
      ;;
    *)
      # Not a flag — stop parsing flags
      break
      ;;
  esac
done

if [ "${1:-}" = "roles" ]; then shift; exec "$CSL_DIR/la-roles.sh" "$@"; fi
if [ "${1:-}" = "setup-remote" ]; then
  shift
  exec python3 "$CSL_DIR/../install/setup-api-keys.py" "$@"
fi
if [ "${1:-}" = "remote" ]; then
  shift
  # No args -> remote-session.sh opens the picker at Remote as a csl submenu (returns via nav file).
  # When picker launches remote as child, it passes --csl-owner and --csl-nav-file.
  if [ "$#" -eq 0 ]; then
    # Create nav file for state sync between picker and remote-session.sh
    navfile="${TMPDIR:-/tmp}/_csl_nav.$$"
    : > "$navfile"
    exec "${CSL_REMOTE_LAUNCHER:-$CSL_DIR/remote-session.sh}" --csl-owner --csl-nav-file "$navfile"
  else
    # With args (alias, --list, --verify, etc.) delegate directly without nav file
    exec "${CSL_REMOTE_LAUNCHER:-$CSL_DIR/remote-session.sh}" "$@"
  fi
fi
if [ "${1:-}" = "local" ] && [ "$#" -eq 1 ]; then exec "$CSL_DIR/session-picker" local; fi
if [ "${1:-}" = "lowkey" ]; then
  shift
  [ "$#" -eq 0 ] && exec "$CSL_DIR/session-picker" lowkey
  exec python3 "$CSL_DIR/lowkey-cli.py" "$@"
fi
if [ "${1:-}" = "download-models" ]; then
  shift
  [ "$#" -eq 0 ] && [ -t 0 ] && exec "$CSL_DIR/session-picker" download
  exec "$CSL_DIR/../install/download-models.sh" "$@"
fi
# shellcheck source=/dev/null
. "$CSL_DIR/../config/config-lib.sh"
# Load shared emoji constants (single source of truth)
# shellcheck source=../config/emoji.sh
. "$CSL_DIR/../config/emoji.sh"
la_load_config || exit 1

# --- registry hygiene: picker-offered registration and removal -------------------------------
# The picker lists on-disk models the registry does not know (auto-scan) and needs a way to
# make them launchable, and a way to retire registrations whose weights are gone from disk.
# Both commands write ONLY $LA_CONFIG_DIR/config.local.sh (+ the tombstone), keep a timestamped
# backup next to it, and verify the result — restoring the backup when the rewritten config
# would not parse, so a broken write can never strand the user's model list.
_LA_CFG="$LA_CONFIG_DIR/config.local.sh"
_cfg_mode() { stat -f '%Lp' "$1" 2>/dev/null; }
_register_model_cmd() {
  local folder="${1:-}"
  if [ -z "$folder" ]; then
    echo "usage: csl --register-model <model-folder>" >&2
    return 2
  fi
  local a
  for a in "${LA_ALIASES[@]}"; do
    if [ "${LA_SUBDIR[$a]:-}" = "$folder" ]; then
      echo "folder '$folder' is already registered as '$a' — nothing to do"
      return 0
    fi
  done
  local alias
  alias=$(printf '%s' "$folder" | sed 's/[^a-zA-Z0-9_-]/-/g')
  if la_lookup "$alias" >/dev/null 2>&1; then
    echo "alias '$alias' already registered — nothing to do"
    return 0
  fi
  if [ ! -f "$_LA_CFG" ]; then
    echo "no config.local.sh at $_LA_CFG" >&2
    return 1
  fi
  # The backend comes from EVIDENCE (bin/la-detect-backend.py): GGUF -> llama_cpp; otherwise the
  # model_type decides — rapid when the pinned rapid can build it (generic `mlx`, the machine
  # default), omlx when only oMLX can (a per-model hard dependency, user 2026-10-15). Refuse
  # rather than register a model that no installed backend can load.
  local detected serve reason
  detected=$(python3 "$CSL_DIR/la-detect-backend.py" "$LA_MODELS_DIR/$folder" 2>/dev/null) || detected=""
  serve=$(printf '%s' "$detected" | awk -F'\t' 'NR==1{print $2}')
  reason=$(printf '%s' "$detected" | awk -F'\t' 'NR==1{print $3}')
  case "$serve" in
    mlx|omlx|llama_cpp) ;;
    unsupported|unknown)
      echo "not registering '$folder': ${reason:-no backend can load it}" >&2
      return 1 ;;
    *) serve=mlx; reason="backend detection unavailable; using the machine default" ;;
  esac
  local backup
  backup=$(_autoreg_backup_name)
  cp "$_LA_CFG" "$backup" || return 1
  local mode; mode=$(_cfg_mode "$_LA_CFG")
  local line="la_register $alias $folder $serve auto \"\" false \"\" medium \"\" \"\" \"\" \"\""
  local block_start="# >>> csl auto-registered (from on-disk scan) >>>"
  local block_end="# <<< csl auto-registered <<<"
  local tmp; tmp=$(mktemp) || return 1
  if grep -qF "$block_start" "$_LA_CFG"; then
    awk -v endmarker="$block_end" -v newline="$line" '
      !done && $0 == endmarker { print newline; done = 1 }
      { print }
    ' "$_LA_CFG" > "$tmp"
  else
    # APPEND the block to the existing content — never replace the file with it.
    { cat "$_LA_CFG"; printf '\n%s\n%s\n%s\n' "$block_start" "$line" "$block_end"; } > "$tmp"
  fi
  [ -n "$mode" ] && chmod "$mode" "$tmp"
  mv "$tmp" "$_LA_CFG"
  # The write is only done when the line actually registers: reload and check, else restore.
  if ! ( set +u; . "${LA_CONFIG_DIR%/}/../config/config-lib.sh" 2>/dev/null || . "$CSL_DIR/../config/config-lib.sh"
        la_load_config >/dev/null 2>&1; la_lookup "$alias" >/dev/null 2>&1 ); then
    mv "$backup" "$_LA_CFG"
    echo "registering '$alias' produced an invalid config — restored the backup" >&2
    return 1
  fi
  echo "registered '$alias' (folder $folder) in config.local.sh — backend $serve: $reason"
  return 0
}
_autoreg_backup_name() {
  printf '%s.bak-autoregister-%s' "$_LA_CFG" "$(date +%Y%m%d-%H%M%S)"
}
_unregister_backup_name() {
  printf '%s.bak-unregister-%s' "$_LA_CFG" "$(date +%Y%m%d-%H%M%S)"
}
_unregister_model_cmd() {
  if [ "$#" -eq 0 ]; then
    echo "usage: csl --unregister-model <alias> [<alias>...]" >&2
    return 2
  fi
  local a
  for a in "$@"; do            # validate everything BEFORE touching anything
    if ! la_lookup "$a" >/dev/null 2>&1; then
      echo "'$a' is not a registered alias — nothing moved" >&2
      la_retired_hint "$a" 2>/dev/null || true
      return 1
    fi
  done
  if [ ! -f "$_LA_CFG" ]; then
    echo "no config.local.sh at $_LA_CFG" >&2
    return 1
  fi
  local backup
  backup=$(_unregister_backup_name)
  cp "$_LA_CFG" "$backup" || return 1
  local mode; mode=$(_cfg_mode "$_LA_CFG")
  local tmp; tmp=$(mktemp) || return 1
  cp "$_LA_CFG" "$tmp"
  for a in "$@"; do
    # Exact-field match, not grep patterns: an alias is data, and a regex-flavoured alias
    # (dots, pluses) must not widen the match to neighbouring registrations.
    awk -v alias="$a" '
      $1 == "la_register" && $2 == alias { next }
      $1 == "la_role" && $3 == alias     { next }
      { print }
    ' "$tmp" > "$tmp.next" && mv "$tmp.next" "$tmp"
  done
  [ -n "$mode" ] && chmod "$mode" "$tmp"
  mv "$tmp" "$_LA_CFG"
  local tomb="$LA_CONFIG_DIR/removed-models.local.psv"
  for a in "$@"; do
    printf '%s|%s|%s|%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$a" "${LA_SUBDIR[$a]:-}" \
      "weights removed from disk; retired via csl" >> "$tomb"
  done
  # Retired means gone: reload and confirm the alias no longer resolves, else restore.
  if ( set +u; . "$CSL_DIR/../config/config-lib.sh" 2>/dev/null
       la_load_config >/dev/null 2>&1; la_lookup "$1" >/dev/null 2>&1 ); then
    mv "$backup" "$_LA_CFG"
    echo "unregistering '$1' did not take effect — restored the backup" >&2
    return 1
  fi
  echo "moved to removed-models list: $* (backup: $(basename "$backup"))"
  return 0
}
if [ "${1:-}" = "--register-model" ]; then
  shift
  _register_model_cmd "$@"
  exit $?
fi
if [ "${1:-}" = "--unregister-model" ]; then
  shift
  _unregister_model_cmd "$@"
  exit $?
fi

EFFORTS=(low medium high xhigh max)     # claude --effort <level>
# Watcher defaults OFF: ordinary selection should open only the requested local session.
# Toggle it with `w`, or set CSL_WATCH=1 to opt in by default.
WATCH="${CSL_WATCH:-0}"

# Apply a model-specific auto-compaction override only inside this csl process.
# The export is inherited by the selected local launcher but cannot propagate
# back into the parent shell or into an independently launched cloud session.
# Precedence: explicit override > local override > selected mode > manifest default > LA_MAX_MODEL_LEN fallback
_apply_session_profile() {
  local alias="$1"
  local explicit_override="${LA_SESSION_AUTO_COMPACT[$alias]:-}"

  if [ -n "$explicit_override" ]; then
    export LA_AUTO_COMPACT_WINDOW="$explicit_override"
    return
  fi

  # Try manifest-driven derivation
  local manifest_json
  manifest_json="$(la_load_manifest "$alias")"
  if [ -n "$manifest_json" ]; then
    local effective
    effective="$(la_manifest_effective_context "$manifest_json")"
    if [ -n "$effective" ]; then
      local autocompact
      autocompact="$(la_manifest_autocompaction "$effective")"
      if [ -n "$autocompact" ]; then
        export LA_AUTO_COMPACT_WINDOW="$autocompact"
        return
      fi
    fi
  fi

  # Fallback to LA_MAX_MODEL_LEN (default 32768 from config-lib.sh)
  # Only set if it meets minimum
  if [ "${LA_MAX_MODEL_LEN:-0}" -ge 100000 ]; then
    local fallback_floor=$(( (LA_MAX_MODEL_LEN / 100000) * 100000 ))
    if [ "$fallback_floor" -gt 1000000 ]; then
      fallback_floor=1000000
    fi
    export LA_AUTO_COMPACT_WINDOW="$fallback_floor"
  fi
}

# Auto-mode triple-toggle state. Three mutually exclusive states cycle with `a`:
#
#   0 = blind-trust   → --permission-mode auto, NO classifier in the loop. Every consequential
#                       call is routed directly to auto. This is the DEFAULT because the genuine
#                       classifier emulation path is not yet working reliably; blind-trust gives
#                       auto-mode behaviour immediately without waiting for a classifier server.
#   1 = classifier    → --permission-mode auto, boots a second local model to judge auto-mode
#                       calls. The real auto mode — requires the classifier warm-up path.
#   2 = off           → --permission-mode acceptEdits. No auto-mode behaviour at all.
#
# Defaults to 0 (blind-trust). Cycle: blind-trust → classifier → off → blind-trust.
# The launcher maps these to LA_AUTO_MODE and LA_BLIND_AUTO:
#   state=0 → LA_AUTO_MODE=1 LA_BLIND_AUTO=1
#   state=1 → LA_AUTO_MODE=1 LA_BLIND_AUTO=0
#   state=2 → LA_AUTO_MODE=0 (LA_BLIND_AUTO is irrelevant)
# Environment overrides: CSL_AUTO_MODE_STATE=<0|1|2> sets the initial state directly.
AUTO_MODE_STATE="${CSL_AUTO_MODE_STATE:-0}"

# Telemetry state. OFF by default: the point of a local session is that the work stays on this
# machine, and a session that still reports to Statsig/Sentry and polls for updates is not that.
# Measured 2026-09-05 on a session whose inference was provably 100% local — it still held two
# outbound HTTPS sockets, to Anthropic (160.79.104.10) and to Google/Statsig (34.149.66.165). Those
# are not inference and they are not the gateway, so they are easy to mistake for noise and easy to
# miss entirely; they are also outbound calls the user never asked for.
#
# TELEMETRY=0 (the default) means "no nonessential traffic". Toggle with `t`, or set CSL_TELEMETRY=1
# to leave the stock behaviour in place. The launcher turns this into the actual env vars, so the
# same switch works for any caller of launch-claude-agent.sh, not just this picker.
TELEMETRY="${CSL_TELEMETRY:-0}"

# Queued-prompt Stop hook (bin/local-queue-stop-hook.py). ON by default: it is a safety net for
# prompts you queue while the model is mid-run, and the failure it catches is silent — the model
# stops, your prompt is never answered, and nothing says so. Defaulting it OFF would mean the net
# is missing exactly when you forgot about it.
#
# Toggle with `s` (home) or `p` (local picker), or set CSL_STOP_HOOK=1 to default it on (OFF by default since 0.22.3). The launcher turns this into
# LA_QUEUE_STOP_HOOK, which the hook reads as an explicit override — so the switch works for any
# caller of launch-claude-agent.sh / remote-session.sh, not just this picker.
#
# The hook only ever engages for sessions started by one of this project's launchers (they stamp
# LA_SESSION_LAUNCHER); an ordinary cloud/gateway `claude` never runs it regardless of this setting.
# An already-exported LA_QUEUE_STOP_HOOK wins: the session picker passes its toggle that way to
# `csl --picker-launch`, and re-deriving from CSL_STOP_HOOK here silently discarded it.
STOP_HOOK="${LA_QUEUE_STOP_HOOK:-${CSL_STOP_HOOK:-0}}"

# Local-capable filter state for the remote roster.
# 0 = HIDDEN (default): local-capable models are hidden in the remote picker.
# 1 = SHOWN: local-capable models are visible and selectable.
# Deliberately NOT shown on the home screen (removed 0.15.1): the filter only ever affects the
# REMOTE roster, so it is remote-lane state, and an abbreviated "Local-cap" sat confusingly next
# to the Local LANE on the same menu. The variable still lives here because it is owned by this
# shell and synced both ways with remote-session.sh -- it is state, not a home-screen control.
LOCAL_CAPABLE="${CSL_LOCAL_CAPABLE:-0}"

# Subagents (0.27.0): free sessions keep the native Agent and Workflow tools; their subagents run on
# the session's own free endpoint (LA_SUBAGENT_ROUTING, see launch-claude-agent.sh). Replacing paid
# subagents is a CLOUD-session setting: FA_REPLACE_AGENTS in ~/.claude/settings.json env, read by
# hooks/cloud-agent-intercept.py (csl -> Cloud Session Configuration, or cloud_session_env.py).

# MCP enablement for blind-trust mode (local + remote sessions)
# 0 = DISABLED (default), 1 = ENABLED (mcp__* allowlisted in blind-trust settings)
# Only effective when AUTO_MODE_STATE=0 (blind-trust) and LA_BLIND_TRUST_OPTION=B
# Flag --enable-mcp sets LA_ENABLE_MCP=1 before this; preserve it if already set
LA_ENABLE_MCP="${LA_ENABLE_MCP:-${CSL_ENABLE_MCP:-0}}"

# Export the stop hook setting for launchers (they read LA_QUEUE_STOP_HOOK)
export LA_QUEUE_STOP_HOOK="$STOP_HOOK"

# Argument passthrough still skips the picker and watcher. It now receives the
# same selected-model profile as an interactive numbered choice.
# `csl --picker-launch <alias> <effort>`: how the picker starts a LOCAL session. It runs as the
# picker's child (the picker resumes when it exits) and keeps csl's own launch semantics: the
# session profile, and the watcher window following THIS pid — `exec` below makes the
# launcher inherit it, exactly as the numbered menu's _launch did.
if [ "${1:-}" = "--picker-launch" ]; then
  shift
  _apply_session_profile "$1"
  if [ "${CSL_WATCH:-0}" = "1" ]; then
    if [ "$(uname -s)" = "Darwin" ] && [ -z "${CSL_NO_WATCH_WINDOW:-}" ]; then
      osascript >/dev/null 2>&1 <<OSA
tell application "Terminal"
  do script "'$WATCHER' --attach $$"
end tell
OSA
      echo "$EMOJI_WATCHER watcher window opened (following pid $$)"
    else
      echo "$EMOJI_WATCHER watcher (run in another terminal): $WATCHER --attach $$"
    fi
  fi
  exec "$LAUNCHER" "$@"
fi

if [ "$#" -gt 0 ]; then
  _apply_session_profile "$1"
  exec "$LAUNCHER" "$@"
fi

# DRY-RUN: show available models and toggles without launching
if [ "${DRY_RUN:-0}" = "1" ]; then
  echo "=== DRY RUN — csl configuration ==="
  echo "Config source: $LA_CONFIG_SOURCE"
  if [ -n "${LA_FALLBACK_CONFIG:-}" ] && [ "$LA_FALLBACK_CONFIG" = "1" ]; then
    echo "  $EMOJI_WARNING Using public fallback defaults (private models not present)"
  fi
  echo
  echo "${SESSION_EMOJI_LOCAL}  Local session models (on disk, session-capable):"
  for a in "${LA_ALIASES[@]}"; do
    case "${LA_SERVE[$a]:-}" in
      rapid|vllm|omlx)
        if la_on_disk "$a"; then
          roles="$(la_roles_for_alias "$a")"
          [ -n "$roles" ] || roles="untagged"
          # Try to show manifest-derived context/autocompaction
          manifest_json="$(la_load_manifest "$a")"
          ctx_info=""
          if [ -n "$manifest_json" ]; then
            effective="$(la_manifest_effective_context "$manifest_json" 2>/dev/null || echo "")"
            autocompact="$(la_manifest_autocompaction "$effective" 2>/dev/null || echo "")"
            if [ -n "$effective" ]; then
              ctx_info=" effective_ctx=$effective"
              [ -n "$autocompact" ] && ctx_info="${ctx_info} autocompact=$autocompact"
            fi
          fi
          printf "  %-30s backend=%-20s thinking=%-5s effort=%-6s roles=%s%s\n" \
            "$a" \
            "$(la_serve_display "$a")" \
            "${LA_THINK[$a]:-?}" \
            "${LA_EFFORT[$a]:-?}" \
            "$roles" \
            "$ctx_info"
        fi
        ;;
      *) ;;
    esac
  done
  echo
  echo "${SESSION_EMOJI_FREE_API}  Remote session agents: (run 'csl remote --list' for full roster)"
  echo "  Provider roster loaded from config"
  echo "  Local-capable filter: $([ "$LOCAL_CAPABLE" = "1" ] && echo "SHOWN" || echo "HIDDEN (default)")"
  echo "  Trial inclusion: $([ "${INCLUDE_TRIALS:-0}" = "1" ] && echo "INCLUDED" || echo "EXCLUDED (default)")"
  echo
  echo "Toggles (persist across lane switches):"
  case "$AUTO_MODE_STATE" in
    0) _am_label="blind-trust" ;;
    1) _am_label="classifier" ;;
    2) _am_label="off" ;;
  esac
  printf "  Auto-mode: %s (cycle with 'a')\n" "$_am_label"
  printf "  Telemetry: %s (toggle with 't')\n" "$([ "$TELEMETRY" = "1" ] && echo ON || echo OFF)"
  printf "  Watcher:   %s (toggle with 'w')\n" "$([ "$WATCH" = "1" ] && echo ON || echo OFF)"
  printf "  Stop hook: %s (toggle with 's')\n" "$([ "$STOP_HOOK" = "1" ] && echo ON || echo OFF)"
  if [ "$AUTO_MODE_STATE" = "0" ]; then
    printf "  MCPs (blind-trust): %s (toggle with 'm')\n" "$([ "$LA_ENABLE_MCP" = "1" ] && echo ENABLED || echo DISABLED)"
  fi
  printf "  Subagents: native Agent/Workflow on the free endpoint (cloud replacement: Cloud Session Configuration)\n"
  echo
  echo "Launcher paths:"
  printf "  Local  : %s\n" "$LAUNCHER"
  printf "  Remote : %s\n" "${CSL_REMOTE_LAUNCHER:-$CSL_DIR/remote-session.sh}"
  echo "Watcher  : $WATCHER"
  exit 0
fi

# Session-capable models only — dispatch-only tiers have no Anthropic /v1/messages surface, so
# they cannot drive an interactive session at all. LA_SERVE holds the RESOLVED backend
# (la_finalize_serve ran inside la_load_config), so only rapid/vllm reach a session.
if [ "${INVENTORY:-0}" = "1" ]; then
  # TSV for the picker: alias, backend, configured effort, roles, explicit family. The registry
  # has no family field yet, so column 5 is empty and the picker classifies by model name.
  # First, registered aliases
  for a in "${LA_ALIASES[@]}"; do
    case "${LA_SERVE[$a]:-}" in
      rapid|vllm|omlx)
        # Registered but its weights are gone: hidden from the launchable list, but REPORTED
        # as #missing so the picker can offer to move it to the removed-models tombstone
        # (user decision 2026-10-15: hiding is right for an intentional deletion, but the
        # registry should not keep the entry forever).
        if ! la_on_disk "$a"; then
          printf '#missing\t%s\t%s\n' "$a" "${LA_SUBDIR[$a]:-}"
          continue
        fi
        printf '%s\t%s\t%s\t%s\t%s\n' "$a" "$(la_serve_display "$a")" "${LA_EFFORT[$a]:-}" \
          "$(la_roles_for_alias "$a")" ""
        ;;
    esac
  done
  # Then, auto-scanned models (on-disk but not registered)
  # Use la_auto_scan_models from config-lib.sh to find them. The backend column is DETECTED
  # (bin/la-detect-backend.py, one call for all folders), so the picker can say before
  # registration whether a model would run on rapid or needs oMLX.
  declare -A _auto_backend=()
  _auto_folders=()
  while IFS= read -r folder; do
    [ -n "$folder" ] && _auto_folders+=("$LA_MODELS_DIR/$folder")
  done < <(la_auto_scan_models)
  if [ "${#_auto_folders[@]}" -gt 0 ]; then
    while IFS=$'\t' read -r _path _backend _rest; do
      _auto_backend[$(basename "$_path")]="$_backend"
    done < <(python3 "$CSL_DIR/la-detect-backend.py" "${_auto_folders[@]}" 2>/dev/null)
  fi
  while IFS= read -r folder; do
    [ -n "$folder" ] || continue
    # Generate a sanitized alias from folder name
    alias=$(printf '%s' "$folder" | sed 's/[^a-zA-Z0-9_-]/-/g')
    # Skip if this folder is already registered under any alias
    registered=0
    for a in "${LA_ALIASES[@]}"; do
      if [ "${LA_SUBDIR[$a]:-}" = "$folder" ]; then
        registered=1
        break
      fi
    done
    [ "$registered" = "1" ] && continue
    # Output auto-scanned entry: alias, backend, effort, roles, family.
    # Backend = what registration would pick: "rapid (auto)" | "omlx (auto)" | "llama_cpp (auto)",
    # or "unsupported (auto)" when no installed backend can build the architecture.
    case "${_auto_backend[$folder]:-mlx}" in
      mlx|unknown) _shown="rapid (auto)" ;;
      *)           _shown="${_auto_backend[$folder]} (auto)" ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\n' "$alias" "$_shown" "medium" "auto-scanned" "$folder"
  done < <(la_auto_scan_models)
  exit 0
fi

# No arguments: the shared picker, starting at Home. Zero on-disk local models is a valid
# first run (Remote, the downloader and the key wizard are all reachable from Home), so this
# no longer exits early the way the numbered menu did.
exec "$CSL_DIR/session-picker" home
