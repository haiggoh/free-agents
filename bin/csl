#!/usr/bin/env bash
# csl — "Claude Code Free-Agents: Session Launcher"
#
#   csl              -> interactive picker (local models, remote API, effort, toggles)
#   csl roles        -> disk-aware role resolver (which on-disk model fills each role)
#   csl remote [args...] -> remote picker, alias, --list, --verify, or --include-trials
#   csl <args...>    -> passed straight through to the local launcher, unchanged (no picker, no watcher)
#
# WHY the picker offers free model×effort and not just presets: dispatching local models as
# SUBAGENTS and running a local model as the SESSION ENGINE are different decisions. For dispatch,
# fixed role archetypes are the point — you route a task to the model whose strengths suit it, and
# that matters most when several agents run at once. For a session there is exactly ONE engine, and
# the model×effort pairing is the main lever you have over speed vs quality for everything you do
# in that session. The primary menu therefore shows every available session model at its configured
# default effort; custom effort composition remains available explicitly.
#
# Duplicates NO config: models, roles and presets all come from the config overlay.
set -uo pipefail
# Resolve symlinks so `csl` on PATH (a symlink into this repo) finds the config (portable).
_s="${BASH_SOURCE[0]}"; while [ -h "$_s" ]; do _d="$(cd -P "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"; case "$_s" in /*) ;; *) _s="$_d/$_s";; esac; done
CSL_DIR="$(cd -P "$(dirname "$_s")" && pwd)"
LAUNCHER="${CSL_LAUNCHER:-$CSL_DIR/launch-claude-agent.sh}"
WATCHER="$CSL_DIR/local-watch.sh"

# Argument parsing BEFORE any work (must support --help/--dry-run without side effects)
# Parse all leading flags first, then handle subcommands/passthrough
while [[ $# -gt 0 ]]; do
  case "${1:-}" in
    -h|--help)
      cat <<'HELP'
csl — Claude Code Free-Agents: Session Launcher

Usage: csl [--help] [--dry-run] | csl roles [args] | csl remote [args] | csl <launcher-args>

Modes:
  csl                    Interactive session launcher (local + remote)
  csl roles [args]       Disk-aware role resolver (la-roles.sh)
  csl remote [args]      Remote free/paid API session launcher
  csl <alias> [effort]   Direct passthrough to local launcher (no picker)

Flags:
  --help       Show this help and exit
  --dry-run                  Validate config and show what would be available, without launching
  --dry-run-skip-preflight   Dry-run without RAM preflight (quick config inspection)
  --enable-mcp               Enable MCPs in blind-trust mode

Subcommands:
  roles              Show which on-disk model fills each role (operator, reasoner, etc.)
  setup-remote       Install / set up remote API keys (csl setup-remote [providers])
  remote             Delegate to remote-session.sh (see 'csl remote --help')

Environment:
  CSL_LAUNCHER           Override local launcher (default: launch-claude-agent.sh)
  CSL_REMOTE_LAUNCHER    Override remote launcher (default: remote-session.sh)
  CSL_WATCH=1            Default watcher ON
  CSL_AUTO_MODE_STATE=0|1|2  Initial auto-mode: 0=blind-trust, 1=classifier, 2=off
  CSL_TELEMETRY=1        Default telemetry ON (default OFF)
  CSL_STOP_HOOK=0        Default stop hook OFF (default ON)
  CSL_LOCAL_CAPABLE=1    Show local-capable models in remote picker (default hidden)

Examples:
  csl                                    # Interactive picker
  csl --dry-run                          # Show available models/toggles without launching
  csl roles                              # Show role bindings
  csl remote --list                      # List remote agents
  csl qwen-3.8-operator high             # Direct launch (no picker)
  csl --enable-mcp                       # Enable MCPs in blind-trust mode
HELP
      exit 0
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --dry-run-skip-preflight)
      export LA_DRY_RUN_SKIP_PREFLIGHT=1
      DRY_RUN=1
      shift
      ;;
    --enable-mcp)
      export LA_ENABLE_MCP=1
      shift
      ;;
    -?*)
      printf 'csl: unrecognised option: %s\n' "$1" >&2
      printf "Try 'csl --help'.\n" >&2
      exit 2
      ;;
    *)
      # Not a flag — stop parsing flags
      break
      ;;
  esac
done

if [ "${1:-}" = "roles" ]; then shift; exec "$CSL_DIR/la-roles.sh" "$@"; fi
if [ "${1:-}" = "setup-remote" ]; then
  shift
  exec python3 "$CSL_DIR/../install/setup-api-keys.py" "$@"
fi
if [ "${1:-}" = "remote" ]; then
  shift
  exec "${CSL_REMOTE_LAUNCHER:-$CSL_DIR/remote-session.sh}" "$@"
fi
# shellcheck source=/dev/null
. "$CSL_DIR/../config/config-lib.sh"
# Load shared emoji constants (single source of truth)
# shellcheck source=../config/emoji.sh
. "$CSL_DIR/../config/emoji.sh"
la_load_config || exit 1

EFFORTS=(low medium high xhigh max)     # claude --effort <level>
# Watcher defaults OFF: ordinary selection should open only the requested local session.
# Toggle it with `w`, or set CSL_WATCH=1 to opt in by default.
WATCH="${CSL_WATCH:-0}"

# Apply a model-specific auto-compaction override only inside this csl process.
# The export is inherited by the selected local launcher but cannot propagate
# back into the parent shell or into an independently launched cloud session.
_apply_session_profile() {
  local alias="$1"
  local auto_compact="${LA_SESSION_AUTO_COMPACT[$alias]:-}"

  if [ -n "$auto_compact" ]; then
    export LA_AUTO_COMPACT_WINDOW="$auto_compact"
  fi
}

# Auto-mode triple-toggle state. Three mutually exclusive states cycle with `a`:
#
#   0 = blind-trust   → --permission-mode auto, NO classifier in the loop. Every consequential
#                       call is routed directly to auto. This is the DEFAULT because the genuine
#                       classifier emulation path is not yet working reliably; blind-trust gives
#                       auto-mode behaviour immediately without waiting for a classifier server.
#   1 = classifier    → --permission-mode auto, boots a second local model to judge auto-mode
#                       calls. The real auto mode — requires the classifier warm-up path.
#   2 = off           → --permission-mode acceptEdits. No auto-mode behaviour at all.
#
# Defaults to 0 (blind-trust). Cycle: blind-trust → classifier → off → blind-trust.
# The launcher maps these to LA_AUTO_MODE and LA_BLIND_AUTO:
#   state=0 → LA_AUTO_MODE=1 LA_BLIND_AUTO=1
#   state=1 → LA_AUTO_MODE=1 LA_BLIND_AUTO=0
#   state=2 → LA_AUTO_MODE=0 (LA_BLIND_AUTO is irrelevant)
# Environment overrides: CSL_AUTO_MODE_STATE=<0|1|2> sets the initial state directly.
AUTO_MODE_STATE="${CSL_AUTO_MODE_STATE:-0}"

# Telemetry state. OFF by default: the point of a local session is that the work stays on this
# machine, and a session that still reports to Statsig/Sentry and polls for updates is not that.
# Measured 2026-09-05 on a session whose inference was provably 100% local — it still held two
# outbound HTTPS sockets, to Anthropic (160.79.104.10) and to Google/Statsig (34.149.66.165). Those
# are not inference and they are not the gateway, so they are easy to mistake for noise and easy to
# miss entirely; they are also outbound calls the user never asked for.
#
# TELEMETRY=0 (the default) means "no nonessential traffic". Toggle with `t`, or set CSL_TELEMETRY=1
# to leave the stock behaviour in place. The launcher turns this into the actual env vars, so the
# same switch works for any caller of launch-claude-agent.sh, not just this picker.
TELEMETRY="${CSL_TELEMETRY:-0}"

# Queued-prompt Stop hook (bin/local-queue-stop-hook.py). ON by default: it is a safety net for
# prompts you queue while the model is mid-run, and the failure it catches is silent — the model
# stops, your prompt is never answered, and nothing says so. Defaulting it OFF would mean the net
# is missing exactly when you forgot about it.
#
# Toggle with `s` (home) or `p` (local picker), or set CSL_STOP_HOOK=0 to default it off. The launcher turns this into
# LA_QUEUE_STOP_HOOK, which the hook reads as an explicit override — so the switch works for any
# caller of launch-claude-agent.sh / remote-session.sh, not just this picker.
#
# The hook only ever engages for sessions started by one of this project's launchers (they stamp
# LA_SESSION_LAUNCHER); an ordinary cloud/gateway `claude` never runs it regardless of this setting.
STOP_HOOK="${CSL_STOP_HOOK:-1}"

# Local-capable filter state for the remote roster.
# 0 = HIDDEN (default): local-capable models are hidden in the remote picker.
# 1 = SHOWN: local-capable models are visible and selectable.
# Deliberately NOT shown on the home screen (removed 0.15.1): the filter only ever affects the
# REMOTE roster, so it is remote-lane state, and an abbreviated "Local-cap" sat confusingly next
# to the Local LANE on the same menu. The variable still lives here because it is owned by this
# shell and synced both ways with remote-session.sh -- it is state, not a home-screen control.
LOCAL_CAPABLE="${CSL_LOCAL_CAPABLE:-0}"

# MCP enablement for blind-trust mode (local + remote sessions)
# 0 = DISABLED (default), 1 = ENABLED (mcp__* allowlisted in blind-trust settings)
# Only effective when AUTO_MODE_STATE=0 (blind-trust) and LA_BLIND_TRUST_OPTION=B
# Flag --enable-mcp sets LA_ENABLE_MCP=1 before this; preserve it if already set
LA_ENABLE_MCP="${LA_ENABLE_MCP:-${CSL_ENABLE_MCP:-0}}"

# Argument passthrough still skips the picker and watcher. It now receives the
# same selected-model profile as an interactive numbered choice.
if [ "$#" -gt 0 ]; then
  _apply_session_profile "$1"
  exec "$LAUNCHER" "$@"
fi

# DRY-RUN: show available models and toggles without launching
if [ "${DRY_RUN:-0}" = "1" ]; then
  echo "=== DRY RUN — csl configuration ==="
  echo "Config source: $LA_CONFIG_SOURCE"
  if [ -n "${LA_FALLBACK_CONFIG:-}" ] && [ "$LA_FALLBACK_CONFIG" = "1" ]; then
    echo "  ⚠ Using public fallback defaults (private models not present)"
  fi
  echo
  echo "Local session models (on disk, session-capable):"
  for a in "${LA_ALIASES[@]}"; do
    case "${LA_SERVE[$a]:-}" in
      rapid|vllm)
        if la_on_disk "$a"; then
          roles="$(la_roles_for_alias "$a")"
          [ -n "$roles" ] || roles="untagged"
          printf "  %-30s backend=%-20s thinking=%-5s effort=%-6s roles=%s\n" \
            "$a" \
            "$(la_serve_display "$a")" \
            "${LA_THINK[$a]:-?}" \
            "${LA_EFFORT[$a]:-?}" \
            "$roles"
        fi
        ;;
      *) ;;
    esac
  done
  echo
  echo "Remote session agents: (run 'csl remote --list' for full roster)"
  echo "  Provider roster loaded from config"
  echo "  Local-capable filter: $([ "$LOCAL_CAPABLE" = "1" ] && echo "SHOWN" || echo "HIDDEN (default)")"
  echo "  Trial inclusion: $([ "${INCLUDE_TRIALS:-0}" = "1" ] && echo "INCLUDED" || echo "EXCLUDED (default)")"
  echo
  echo "Toggles (persist across lane switches):"
  case "$AUTO_MODE_STATE" in
    0) _am_label="blind-trust" ;;
    1) _am_label="classifier" ;;
    2) _am_label="off" ;;
  esac
  printf "  Auto-mode: %s (cycle with 'a')\n" "$_am_label"
  printf "  Telemetry: %s (toggle with 't')\n" "$([ "$TELEMETRY" = "1" ] && echo ON || echo OFF)"
  printf "  Watcher:   %s (toggle with 'w')\n" "$([ "$WATCH" = "1" ] && echo ON || echo OFF)"
  printf "  Stop hook: %s (toggle with 's')\n" "$([ "$STOP_HOOK" = "1" ] && echo ON || echo OFF)"
  if [ "$AUTO_MODE_STATE" = "0" ]; then
    printf "  MCPs (blind-trust): %s (toggle with 'u')\n" "$([ "$LA_ENABLE_MCP" = "1" ] && echo ENABLED || echo DISABLED)"
  fi
  echo
  echo "Launcher paths:"
  printf "  Local  : %s\n" "$LAUNCHER"
  printf "  Remote : %s\n" "${CSL_REMOTE_LAUNCHER:-$CSL_DIR/remote-session.sh}"
  echo "Watcher  : $WATCHER"
  exit 0
fi

# Session-capable models only — dispatch-only tiers have no Anthropic /v1/messages surface, so
# they cannot drive an interactive session at all. mlx_lm.server serves OpenAI-only under a path
# id; llama.cpp's llama-server likewise. rapid and vllm both expose /v1/messages.
# LA_SERVE holds the RESOLVED backend (la_finalize_serve ran inside la_load_config), so the
# generic "mlx" / "" declarations never reach this test — they arrive here as rapid or vllm.
SESSION_ALIASES=()
for a in "${LA_ALIASES[@]}"; do
  case "${LA_SERVE[$a]:-}" in
    rapid|vllm)
      la_on_disk "$a" && SESSION_ALIASES+=("$a")
      ;;
    *) ;;
  esac
done

if [ "${#SESSION_ALIASES[@]}" -eq 0 ]; then
  echo "No on-disk models with an Anthropic-compatible session backend are available." >&2
  exit 1
fi

MODEL_LABELS=()
for a in "${SESSION_ALIASES[@]}"; do
  roles="$(la_roles_for_alias "$a")"
  [ -n "$roles" ] || roles="untagged"
  MODEL_LABELS+=("$(
    printf '%-30s backend=%-20s thinking=%-5s effort=%-6s roles=%s' \
      "$a" \
      "$(la_serve_display "$a")" \
      "${LA_THINK[$a]:-?}" \
      "${LA_EFFORT[$a]:-?}" \
      "$roles"
  )")
done

_pick_from() {   # $1=prompt  $2=default index (1-based)  rest=items -> echoes chosen 1-based index
  # The list and the prompt go to STDERR on purpose: this function is called inside $(...), which
  # captures stdout, so anything printed there would be swallowed into the caller's variable
  # instead of shown to the user (and would then fail the numeric check).
  local prompt="$1" def="$2"; shift 2
  local n=$#
  local i=1
  for it in "$@"; do printf "  %d) %s\n" "$i" "$it" >&2; i=$((i+1)); done
  local c; printf "%s [%s]: " "$prompt" "$def" >&2; read -r c; c="${c:-$def}"
  if ! [[ "$c" =~ ^[0-9]+$ ]] || [ "$c" -lt 1 ] || [ "$c" -gt "$n" ]; then echo "0"; return; fi
  echo "$c"
}

# 🛰️  REMOTE cloud-API agents are a DELIBERATELY SEPARATE list from the local models
# above: a remote agent runs on a third party's hardware over the network, with a
# different cost model (free-tier quota, not free compute) and a different privacy
# posture (prompts leave this machine). Mixing them into one menu would make those
# two very different choices look interchangeable, so `r` opens its own roster.
_remote_launcher() { echo "${CSL_REMOTE_LAUNCHER:-$CSL_DIR/remote-session.sh}"; }

_launch_remote() {  # opens the remote roster and hands off; never returns on success
  local rl; rl="$(_remote_launcher)"
  if [ ! -x "$rl" ]; then
    echo "csl: remote session launcher not found or not executable: $rl" >&2
    return 1
  fi

  # Build arguments to pass through to remote-session.sh to match current CSL state
  local remote_args=()

  # Watcher is deliberately NOT passed through: remote-session.sh does not support it
  # (deferred — see docs/ROADMAP.md). Forwarding it would make the remote launch exit 2.
  if [ "$WATCH" = "1" ]; then
    echo "note: watcher stays off for remote sessions (not supported yet); local sessions keep it." >&2
  fi

  # Pass through auto-mode state (cycle to match current state)
  local i=0
  while [ $i -lt "$AUTO_MODE_STATE" ]; do
    remote_args+=("-a")
    i=$((i + 1))
  done

  # Pass through telemetry state
  if [ "$TELEMETRY" = "1" ]; then
    remote_args+=("-t")
  fi

  # Pass through local-capable filter state
  if [ "$LOCAL_CAPABLE" = "1" ]; then
    remote_args+=("--local-capable-shown")
  fi

  # The stop-hook state travels as an env var, not a flag: remote-session.sh exports it for the
  # claude child, and the hook reads it as an explicit override.
  exec env LA_QUEUE_STOP_HOOK="$STOP_HOOK" "$rl" "${remote_args[@]}"
}

# Map the triple-toggle state to the env vars launch-claude-agent.sh expects.
# State 0 (blind-trust)  → LA_AUTO_MODE=1 LA_BLIND_AUTO=1
# State 1 (classifier)   → LA_AUTO_MODE=1 LA_BLIND_AUTO=0
# State 2 (off)          → LA_AUTO_MODE=0
_la_auto_mode_val() { [ "$AUTO_MODE_STATE" = "2" ] && echo 0 || echo 1; }
_la_blind_auto_val() { [ "$AUTO_MODE_STATE" = "0" ] && echo 1 || echo 0; }

_launch() {  # $1=alias  $2=effort(optional)
  local alias="$1" effort="${2:-}"
  _apply_session_profile "$alias"
  if [ "$WATCH" = "1" ]; then
    if [ "$(uname -s)" = "Darwin" ]; then
      # $$ is THIS shell's pid, and `exec` below replaces it with the launcher — so the pid the
      # watcher is told to follow is exactly the launcher pid it will see in pgrep. --attach waits
      # for that session's port/transcript sidecars, so spawning it first is safe.
      osascript >/dev/null 2>&1 <<OSA
tell application "Terminal"
  do script "'$WATCHER' --attach $$"
end tell
OSA
      echo "🔭 watcher window opened (following pid $$; engine health now, mutations from turn 1)"
    else
      echo "🔭 watcher (run in another terminal): $WATCHER --attach $$"
    fi
  fi
  local _am _ba
  _am="$(_la_auto_mode_val)"
  _ba="$(_la_blind_auto_val)"
  if [ -n "$effort" ]; then
    exec env LA_AUTO_MODE="$_am" LA_BLIND_AUTO="$_ba" LA_TELEMETRY="$TELEMETRY" LA_QUEUE_STOP_HOOK="$STOP_HOOK" LA_ENABLE_MCP="$LA_ENABLE_MCP" "$LAUNCHER" "$alias" "$effort"
  else
    exec env LA_AUTO_MODE="$_am" LA_BLIND_AUTO="$_ba" LA_TELEMETRY="$TELEMETRY" LA_QUEUE_STOP_HOOK="$STOP_HOOK" LA_ENABLE_MCP="$LA_ENABLE_MCP" "$LAUNCHER" "$alias"
  fi
}

# ---------------------------------------------------------------------------
# Box drawing. The menus are framed with box characters, and every row used to be
# padded by a HAND-COUNTED printf width ("%-25s" plus literal trailing spaces).
# That cannot stay aligned once emoji are in the text, for two reasons:
#
#   1. an emoji occupies TWO terminal columns but is ONE character, so any
#      character-count padding is short by one column per emoji;
#   2. several of these emoji are TWO codepoints -- a base glyph plus U+FE0F
#      VARIATION SELECTOR-16 (🔭 🛰️ 🔆). Those report East-Asian-width "NA",
#      so even a width-aware routine misjudges them unless VS16 is handled
#      explicitly. This is why some rows were off by one and others by two.
#
# So rows are padded by measured DISPLAY WIDTH instead of by character count.
# BOX_INNER is the printable width between the two frame characters; change it
# once and every row, rule and header follows.
# ---------------------------------------------------------------------------
BOX_INNER=62

# _box <kind> [text...] — render framed menu rows in ONE python3 call.
# Per-row shelling out would put a process launch on every menu repaint; the whole
# box is cheap to build at once. Each argument is one row; the kind selects the
# frame pieces. Rows are padded by MEASURED DISPLAY WIDTH, never by character count.
#   top | mid | bottom          — a horizontal rule
#   row  <text>...              — left-aligned rows
#   center <text>...            — centered rows
_box() {
  LC_ALL=en_US.UTF-8 python3 -c '
import sys, unicodedata

INNER = int(sys.argv[1])
kind = sys.argv[2]
rows = sys.argv[3:]


def width(text):
    """Display columns. Two traps, both of which bit the hand-counted version:
    an emoji is one character but two columns, and several of these emoji are a
    base glyph plus U+FE0F VARIATION SELECTOR-16, which adds no width at all."""
    total = 0
    for char in text:
        if char == "\ufe0f" or unicodedata.combining(char):
            continue
        if unicodedata.east_asian_width(char) in ("W", "F") or ord(char) >= 0x1F300:
            total += 2
        else:
            total += 1
    return total


if kind in ("top", "mid", "bottom"):
    left, right = {"top": "╔╗", "mid": "╠╣", "bottom": "╚╝"}[kind]
    print(left + "═" * INNER + right)
else:
    def truncate(text):
        """Clip to INNER columns, ellipsis included. Padding cannot rescue a row that is
        WIDER than the frame, and an overflowing row breaks the box as visibly as a
        short one -- the Config path and the Remote lane line both did."""
        if width(text) <= INNER:
            return text
        out = ""
        for char in text:
            if width(out + char) > INNER - 1:
                break
            out += char
        return out + "…"

    for text in rows:
        if kind == "center":
            text = " " * max(0, (INNER - width(text)) // 2) + text
        text = truncate(text)
        print("║" + text + " " * max(0, INNER - width(text)) + "║")
' "$BOX_INNER" "$@"
}

# ---------------------------------------------------------------------------
# Home lane selector — the top-level screen that appears before either picker.
# The user picks local, remote, or quits. Shared state (auto-mode, telemetry,
# watcher, stop-hook, local-capable) is preserved across lane switches.
# ---------------------------------------------------------------------------
_pick_home_lane() {
  NEXT_LANE=""
  echo
  _box top
  _box center "Claude Code Free-Agents: Session Launcher"
  _box mid
  _box row "$(printf '  Config: %s' "$LA_CONFIG_SOURCE")"
  if [ -n "${LA_FALLBACK_CONFIG:-}" ] && [ "$LA_FALLBACK_CONFIG" = "1" ]; then
    _box row "  ⚠ Using public fallback defaults. Private models" \
             "    are not present in this installed copy."
  fi
  _box mid
  # Main session type selection — equal options, no numbered preference
  # Primary: < = local (points to this machine), # = remote (web/telephone symbol)
  # Full words 'local'/'remote' accepted but not advertised
  _box row \
    "$(printf '  <) %s Local  — MLX models on this machine (%d on disk)' "$SESSION_EMOJI_LOCAL" "${#SESSION_ALIASES[@]}")" \
    "$(printf '  #) %s Remote — Free/paid cloud API (provider quotas apply)' "$SESSION_EMOJI_FREE_API")"
  _box mid
  _box row \
    "  k) $EMOJI_KEY Install / set up remote API keys" \
    "  m) $EMOJI_TOOLS Manage Rapid-MLX runtime (install/update/inspect)" \
    "  q) Quit"
  _box mid
  # Toggles — come AFTER main options, same label:value alignment
  case "$AUTO_MODE_STATE" in
    0) _am_label="blind-trust" ;;
    1) _am_label="classifier" ;;
    2) _am_label="off" ;;
  esac
  _box row \
    "$(printf '  a) %s Auto-mode: %s' "$EMOJI_AUTO_MODE" "$_am_label")" \
    "$(printf '  t) %s Telemetry: %s' "$EMOJI_TELEMETRY_ON" "$([ "$TELEMETRY" = "1" ] && echo ON || echo OFF)")" \
    "$(printf '  w) %s Watcher:   %s' "$EMOJI_WATCHER" "$([ "$WATCH" = "1" ] && echo ON || echo OFF)")" \
    "$(printf '  s) %s Stop hook: %s' "$EMOJI_STOP_HOOK" "$([ "$STOP_HOOK" = "1" ] && echo ON || echo OFF)")"
  _box bottom
  printf "Select [</#/k/m/q/a/t/w/s/u]: " >&2
  read -r sel; sel="${sel:-<}"
  case "$sel" in
    '<'|local|LOCAL) NEXT_LANE="local" ;;
    '#'|remote|REMOTE) NEXT_LANE="remote" ;;
    k|K) NEXT_LANE="install" ;;
    m|M) python3 "$CSL_DIR/../install/manage-rapid-mlx.py"; NEXT_LANE="home" ;;
    q|Q) NEXT_LANE="quit" ;;
    a|A) AUTO_MODE_STATE=$(( (AUTO_MODE_STATE + 1) % 3 )); NEXT_LANE="home" ;;
    t|T) if [ "$TELEMETRY" = "1" ]; then TELEMETRY=0; else TELEMETRY=1; fi; NEXT_LANE="home" ;;
    w|W) if [ "$WATCH" = "1" ]; then WATCH=0; else WATCH=1; fi; NEXT_LANE="home" ;;
    s|S) if [ "$STOP_HOOK" = "1" ]; then STOP_HOOK=0; else STOP_HOOK=1; fi; NEXT_LANE="home" ;;
    *) NEXT_LANE="home"; echo "Invalid selection." >&2 ;;
  esac
}

# ---------------------------------------------------------------------------
# Local picker — returns via NEXT_LANE when the user navigates away or quits.
# ---------------------------------------------------------------------------
_run_local_picker() {
  NEXT_LANE="home"
  while :; do
    echo
    _box top
    _box center "$SESSION_EMOJI_LOCAL Local Session Picker"
    _box mid
    _box row "$(printf '  %d model(s) on disk (session-capable)' "${#SESSION_ALIASES[@]}")"
    _box mid
    echo "Available models (on disk, session-capable; numbered rows use the configured effort):"
    for ((i=0; i<${#MODEL_LABELS[@]}; i++)); do
      printf "  %d) %s\n" "$((i+1))" "${MODEL_LABELS[$i]}"
    done
    echo
    # Navigation first, then lane switching, then settings, then quit — the same
    # order the remote picker uses, so the two lanes read as one interface.
    echo "  h) $EMOJI_HOME back to lane selector"
    echo "  c) $EMOJI_EFFORT choose a listed model × custom effort"
    echo "  s) $SESSION_EMOJI_FREE_API switch to remote API agents (provider/model; account quotas apply)"
    echo "     Cerebras trial opt-in: csl remote --include-trials"
    echo "  k) $EMOJI_KEY set up remote API keys"
    echo "  M) $EMOJI_TOOLS manage Rapid-MLX runtime (install/update/inspect)"
    case "$AUTO_MODE_STATE" in
      0) echo "  a) $EMOJI_AUTO_MODE auto-mode: blind-trust — auto with no classifier (cycle)" ;;
      1) echo "  a) $EMOJI_AUTO_MODE auto-mode: classifier  — auto with local classifier (cycle)" ;;
      2) echo "  a) $EMOJI_AUTO_MODE auto-mode: off         — acceptEdits; no classifier (cycle)" ;;
    esac
    if [ "$TELEMETRY" = "1" ]; then echo "  t) $EMOJI_TELEMETRY_ON telemetry: ON  — stock Claude Code reporting/update checks (toggle)"
    else                            echo "  t) $EMOJI_TELEMETRY_ON telemetry: OFF — no nonessential outbound traffic (toggle)"; fi
    if [ "$WATCH" = "1" ]; then echo "  w) $EMOJI_WATCHER watcher: ON  — opens a window following this session (toggle)"
    else                        echo "  w) $EMOJI_WATCHER watcher: OFF — no monitor window (toggle)"; fi
    if [ "$STOP_HOOK" = "1" ]; then echo "  p) $EMOJI_STOP_HOOK queued-prompt hook: ON  — wakes the model for prompts you queued (toggle)"
    else                            echo "  p) $EMOJI_STOP_HOOK queued-prompt hook: OFF — queued prompts may go unanswered (toggle)"; fi
    if [ "$AUTO_MODE_STATE" = "0" ]; then
        if [ "$LA_ENABLE_MCP" = "1" ]; then echo "  u) $EMOJI_MCP mcps (blind-trust): ENABLED (toggle)"
        else                           echo "  u) $EMOJI_MCP mcps (blind-trust): DISABLED (toggle)"; fi
    fi
    echo "  q) quit"
    echo
    printf "Selection [1]: "; read -r sel; sel="${sel:-1}"
    case "$sel" in
      q|Q) NEXT_LANE="quit"; return ;;
      h|H) NEXT_LANE="home"; return ;;
      k|K) python3 "$CSL_DIR/../install/setup-api-keys.py"; continue ;;
      M|m) python3 "$CSL_DIR/../install/manage-rapid-mlx.py"; continue ;;
      s|S) NEXT_LANE="remote"; return ;;
      w|W) if [ "$WATCH" = "1" ]; then WATCH=0; else WATCH=1; fi; continue ;;
      a|A) AUTO_MODE_STATE=$(( (AUTO_MODE_STATE + 1) % 3 )); continue ;;
      b|B) AUTO_MODE_STATE=0; continue ;;  # b shortcut: jump straight to blind-trust
      t|T) if [ "$TELEMETRY" = "1" ]; then TELEMETRY=0; else TELEMETRY=1; fi; continue ;;
      p|P) if [ "$STOP_HOOK" = "1" ]; then STOP_HOOK=0; else STOP_HOOK=1; fi; continue ;;
      u|U)
        if [ "$AUTO_MODE_STATE" = "0" ]; then
          if [ "$LA_ENABLE_MCP" = "1" ]; then LA_ENABLE_MCP=0; else LA_ENABLE_MCP=1; fi
          echo "  MCPs in blind-trust mode: $([ "$LA_ENABLE_MCP" = "1" ] && echo ENABLED || echo DISABLED)" >&2
        else
          echo "  MCPs in blind-trust mode only available when auto-mode is blind-trust (a to cycle)" >&2
        fi
        continue ;;
      c|C)
        echo >&2
        echo "Models (on disk, session-capable):" >&2
        mi=$(_pick_from "Model" 1 "${MODEL_LABELS[@]}")
        [ "$mi" = "0" ] && { echo "Invalid selection."; continue; }
        chosen="${SESSION_ALIASES[$((mi-1))]}"
        echo >&2
        echo "Effort — higher reasons more and takes longer; lower answers sooner:" >&2
        ei=$(_pick_from "Effort" 3 "${EFFORTS[@]}")
        [ "$ei" = "0" ] && { echo "Invalid selection."; continue; }
        _launch "$chosen" "${EFFORTS[$((ei-1))]}"
        ;;
      *)
        if ! [[ "$sel" =~ ^[0-9]+$ ]] || [ "$sel" -lt 1 ] || [ "$sel" -gt "${#SESSION_ALIASES[@]}" ]; then
          echo "Invalid selection."; continue
        fi
        chosen="${SESSION_ALIASES[$((sel-1))]}"
        _launch "$chosen" "${LA_EFFORT[$chosen]:-}"
        ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# Main loop — owns the interactive state. Each lane runs as a function in this
# shell so state (AUTO_MODE_STATE, TELEMETRY, WATCH, STOP_HOOK, LOCAL_CAPABLE)
# is preserved across lane switches without subshell isolation.
# ---------------------------------------------------------------------------
NEXT_LANE="home"
while [ "$NEXT_LANE" != "quit" ]; do
  case "$NEXT_LANE" in
    home)   _pick_home_lane ;;
    local)  _run_local_picker ;;
    remote)
      # Delegate to remote-session.sh which now has its own interactive loop.
      # It returns (does not exec) when the user navigates back or quits.
      rl="$(_remote_launcher)"
      if [ ! -x "$rl" ]; then
        echo "csl: remote session launcher not found or not executable: $rl" >&2
        NEXT_LANE="home"
        continue
      fi
      # Build args matching current state
      remote_args=()
      if [ "$WATCH" = "1" ]; then
        echo "note: watcher stays off for remote sessions (not supported yet); local sessions keep it." >&2
      fi
      i=0
      while [ $i -lt "$AUTO_MODE_STATE" ]; do
        remote_args+=("-a")
        i=$((i + 1))
      done
      [ "$TELEMETRY" = "1" ] && remote_args+=("-t")
      [ "$LOCAL_CAPABLE" = "1" ] && remote_args+=("--local-capable-shown")
      [ "$LA_ENABLE_MCP" = "1" ] && remote_args+=("--enable-mcp")
      remote_args+=("--csl-owner")
      # Run remote picker in current shell (not exec) so we can return here.
      # remote-session.sh must support --csl-owner to not exec on selection.
      # CSL_NAV_FILE is keyed on THIS shell's $$, since remote-session.sh runs as a
      # child process with its own, different $$ — it cannot discover our pid on its own.
      navfile="/tmp/_csl_nav.$$"
      rm -f "$navfile"
      env LA_QUEUE_STOP_HOOK="$STOP_HOOK" CSL_NAV_FILE="$navfile" bash "$rl" "${remote_args[@]}"
      # Read nav file: first line = navigation target, subsequent lines = KEY=VALUE state sync
      # Reset NEXT_LANE to read fresh from nav file
      NEXT_LANE=""
      if [[ -f "$navfile" ]]; then
        while IFS= read -r line; do
          if [[ -z "$NEXT_LANE" ]]; then
            NEXT_LANE="$line"
          else
            case "$line" in
              AUTO_MODE_STATE=*) AUTO_MODE_STATE="${line#*=}" ;;
              LOCAL_CAPABLE=*)   LOCAL_CAPABLE="${line#*=}" ;;
              TELEMETRY=*)       TELEMETRY="${line#*=}" ;;
              INCLUDE_TRIALS=*)  ;;  # not tracked in csl, remote-only
              EFFORT_CHOICE=*)   ;;  # not tracked in csl, remote-only
            esac
          fi
        done < "$navfile"
      else
        NEXT_LANE="home"
      fi
      rm -f "$navfile"
      # Default if nav file was empty or missing
      [[ -z "${NEXT_LANE:-}" ]] && NEXT_LANE="home"
      # Handle "stay" - remain in remote lane with updated state
      if [[ "$NEXT_LANE" == "stay" ]]; then
        NEXT_LANE="remote"
      fi
      ;;
    install) python3 "$CSL_DIR/../install/setup-api-keys.py"; NEXT_LANE="home" ;;
    *) echo "internal error: invalid lane '$NEXT_LANE'" >&2; NEXT_LANE="home" ;;
  esac
done
exit 0